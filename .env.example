# ==============================================================================
# Glassmorphic Professional Resume - Environment Configuration Template
# ==============================================================================

# --- Application & Server Settings ---
PORT=3001
NODE_ENV=development
APP_URL=http://localhost

# --- Database & Persistence (PostgreSQL) ---
DATABASE_URL="postgresql://postgres:postgres@postgres:5432/glasshub_db?schema=public"
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=glasshub_db
POSTGRES_PORT=5432

# --- Message Broker & Caching (Redis) ---
REDIS_HOST=redis
REDIS_PORT=6379
USE_REDIS=true

# --- Security & JWT Authentication ---
JWT_SECRET=glasshub_super_secret_jwt_key_2026_change_in_production
JWT_ACCESS_EXPIRATION=900
JWT_REFRESH_EXPIRATION=604800

# --- AI & LLM Engine (Ollama / Local Llama 3.2 & TranslateGemma) ---
OLLAMA_HOST=http://ollama:11434
AI_MODEL_ATS=llama3.2
AI_MODEL_TRANSLATION=translategemma

# --- Observability & Telemetry (Datadog) ---
# Set DD_ENABLED=true only when you have a valid Datadog API Key
DD_ENABLED=false
DD_API_KEY=
DD_SITE=datadoghq.com
DD_LOGS_ENABLED=false
DD_LOGS_CONFIG_CONTAINER_COLLECT_ALL=false

# --- Multichannel Notifications (Optional) ---
NOTIFICATION_EMAIL_ENABLED=false
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@glasshub.io

NOTIFICATION_WHATSAPP_ENABLED=false
WHATSAPP_WEBHOOK_URL=
WHATSAPP_API_KEY=
