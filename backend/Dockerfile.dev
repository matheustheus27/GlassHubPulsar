FROM node:22-slim

# Install dependencies required for stable execution of headless Puppeteer on Linux
RUN apt-get update && apt-get install -y \
    chromium \
    fonts-ipafont-gothic \
    fonts-wqy-zenhei \
    fonts-thai-tlwg \
    fonts-kacst \
    fonts-freefont-ttf \
    libxss1 \
    --no-install-recommends \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY package*.json ./

# 🌟 SCOPE PRIVILEGE CONCEPT: Set the global environment variable inside the container
ENV PUPPETEER_SKIP_DOWNLOAD=true

# Install local dependencies and nodemon globally for real-time Node server hot reloading
RUN npm install && npm install -g nodemon

COPY . .

EXPOSE 3001

# Start the server with live file watching
CMD ["nodemon", "server.js"]